# Copiar a .env.local y completar. Nunca subir .env.local al repositorio.

# Supabase (proyecto de la empresa): Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Conexión del servidor a PostgreSQL con el rol app_servidor (sin BYPASSRLS),
# por el pooler en modo transacción. Ver docs/tecnico/base-de-datos.md.
DATABASE_URL=postgres://app_servidor.<ref>:<clave>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Solo para aplicar migraciones (rol dueño de las tablas). No se usa en la aplicación.
DATABASE_MIGRACIONES_URL=postgres://postgres.<ref>:<clave>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
