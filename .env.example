# Copiar a .env.local y completar. Nunca subir .env.local al repositorio.

# Supabase (proyecto de la empresa): Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Clave secreta (Project Settings → API Keys → Secret keys). Solo la usa el servidor para crear
# y administrar las cuentas de los usuarios. Nunca va al navegador ni al repositorio.
SUPABASE_SECRET_KEY=sb_secret_...

# Conexión del servidor a PostgreSQL con el rol app_servidor (sin BYPASSRLS),
# por el pooler en modo transacción. Ver docs/tecnico/base-de-datos.md.
DATABASE_URL=postgres://app_servidor.<ref>:<clave>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# Opcional: conexiones por instancia (5 por defecto; en Vercel conviene 1).
# DATABASE_POOL_MAX=5
# Opcional, solo ante un problema: vuelve a las transacciones comunes del driver (más lentas).
# Ver "Velocidad" en docs/tecnico/base-de-datos.md.
# DATABASE_TRANSACCION_SIMPLE=1

# Solo para aplicar migraciones (rol dueño de las tablas). No se usa en la aplicación.
DATABASE_MIGRACIONES_URL=postgres://postgres.<ref>:<clave>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
